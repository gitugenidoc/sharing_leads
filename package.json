{
  "name": "lead-management-dashboard",
  "version": "1.0.0",
  "description": "Lead Management Dashboard with Admin and Agent roles",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "start:mutuelle": "node backend/server-mutuelle.js",
    "start:mock": "node backend/server-mutuelle.js",
    "dev": "nodemon backend/server.js",
    "dev:mutuelle": "nodemon backend/server-mutuelle.js",
    "dev:mock": "nodemon backend/server-mutuelle.js",
    "db:migrate": "node backend/db/migrate.js",
    "db:reset": "node backend/db/reset.js",
    "db:fix-center": "node backend/db/migrate-runner.js fix-center-assignment.sql",
    "db:seed": "node backend/db/migrate-runner.js seed.sql",
    "db:seed:mutuelle": "node backend/db/migrate-runner.js seed-mutuelle.sql",
    "db:schema": "node backend/db/migrate-runner.js schema.sql",
    "check": "node --check backend/server.js && node --check backend/db/migrate.js && node --check backend/models/User.js && node --check backend/models/Client.js && node --check backend/routes/auth.js && node --check backend/routes/clients.js && node --check backend/routes/users.js && node --check backend/routes/logs.js && node --check backend/routes/mail.js && node --check backend/routes/analytics.js",
    "test": "node --test"
  },
  "keywords": [
    "leads",
    "management",
    "dashboard"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.0",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "pg": "^8.10.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
