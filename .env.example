# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lead_management
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Server
PORT=5000
NODE_ENV=development
CRON_SECRET=change_me_for_vercel_cron

# Frontend
FRONTEND_URL=http://localhost:5000

# SMTP / Email Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM="SecurAssure" <contact@jechangemamutuelle.online>

# SMS optionnel
# Par defaut, l'app enregistre/pre-remplit seulement les SMS.
# Si vous retirez Twilio completement, laissez SMS_SEND_MODE=prepared.
# Mettez SMS_SEND_MODE=provider uniquement si vous branchez un provider SMS dedie.
# SMS_SEND_MODE=prepared
# SMS_PROVIDER=manual

# WhatsApp Cloud API Meta
# Webhook public a configurer chez Meta: https://votre-domaine.com/api/whatsapp/webhook
# WHATSAPP_API_BASE_URL=https://graph.facebook.com
# WHATSAPP_API_VERSION=v20.0
# WHATSAPP_ACCESS_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_VERIFY_TOKEN=choisissez_un_token_secret

# Snaptel + Infinivox telephony webhook
# Snaptel gere le declenchement et le contexte d'appel.
# Infinivox porte la voix via le trunk SIP / SIP gateway cote Snaptel.
# Webhook legacy: https://votre-domaine.com/api/snaptel/webhook
# Webhook CRM (recommande): https://votre-domaine.com/api/webhooks/snaptel/call-event
# Le secret par centre est genere dans Parametres > Integrations > Snaptel (header X-Snaptel-Secret).
# SNAPTEL_WEBHOOK_SECRET reste supporte pour compatibilite legacy.
# SNAPTEL_WEBHOOK_SECRET=choisissez_un_token_secret
# URL publique du CRM (pour generer l'URL webhook affichee dans l'admin)
# APP_BASE_URL=https://votre-domaine.com
# Cle de chiffrement des secrets d'integration (sinon JWT_SECRET est utilise)
# INTEGRATION_SECRET_KEY=change_me_in_production
# Webhook de campagne Snaptel appele par ShareLeads lors d'un clic "Appeler"
# SNAPTEL_CAMPAIGN_WEBHOOK_URL=https://snaptel-callback-v3.vercel.app/api/webhooks/campaigns/...
# Optionnel si Snaptel demande un header secret pour le webhook de campagne
# SNAPTEL_CAMPAIGN_WEBHOOK_SECRET=choisissez_un_token_secret
# SNAPTEL_CAMPAIGN_WEBHOOK_SECRET_HEADER=x-snaptel-secret
# Mode de partage des donnees vers Snaptel: `minimal` recommande, `full` si besoin explicite
# SNAPTEL_DATA_MODE=minimal

# Coveo Chatbot / Gemma
# Derniere branche Gemma officielle au 05/06/2026: Gemma 4.
# Mode OpenRouter recommande pour Gemma 4 hosted:
# GEMMA_API_TYPE=openrouter
# GEMMA_API_URL=https://openrouter.ai/api/v1
# GEMMA_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_API_KEY=your_openrouter_key
# OPENROUTER_SITE_URL=http://localhost:5000
# OPENROUTER_APP_NAME=SecurAssure Coveo Assistant
#
# Mode Google direct:
# GEMMA_API_TYPE=google_genai
# GEMMA_MODEL=gemma-4-12b-it
# GEMMA_API_KEY=your_google_ai_studio_or_google_genai_key
# GEMMA_API_URL=https://generativelanguage.googleapis.com/v1beta
#
# Mode local Ollama:
# GEMMA_API_TYPE=ollama
# GEMMA_API_URL=http://localhost:11434
# GEMMA_MODEL=gemma4:12b
#
# Mode OpenAI-compatible (vLLM, LM Studio, proxy):
# GEMMA_API_TYPE=openai_compatible
# GEMMA_API_URL=http://localhost:8000/v1
# GEMMA_MODEL=gemma-4-12b-it
# GEMMA_TEMPERATURE=0.3
# GEMMA_MAX_OUTPUT_TOKENS=900
# CHATBOT_MAX_MESSAGE_LENGTH=2000
