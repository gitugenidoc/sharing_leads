generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  fullName      String
  email         String         @unique
  passwordHash  String
  phoneNumber   String?        @unique
  role          String
  territory     String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignedLeads Lead[]
  contacts      Contact[]      @relation("AgentContacts")
  tasks         Task[]         @relation("TaskOwner")
  visits        Visit[]
  activities    Activity[]
  notifications Notification[]
  callEvents    CallEvent[]
}

model Lead {
  id              String         @id @default(cuid())
  fullName        String
  phoneNumber     String         @unique
  email           String?
  companyName     String?
  address         String?
  city            String?
  sector          String?
  source          String?
  status          String         @default("NEW")
  stage           String         @default("NOUVEAU_LEAD")
  score           Int            @default(0)
  annualPotential Float?
  notesSummary    String?
  nextActionAt    DateTime?
  lastContactAt   DateTime?
  assignedAgentId String?
  assignedAgent   User?          @relation(fields: [assignedAgentId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tasks           Task[]
  visits          Visit[]
  activities      Activity[]
  callEvents      CallEvent[]
}

model Contact {
  id              String   @id @default(cuid())
  fullName        String
  companyName     String?
  roleTitle       String?
  phoneNumber     String?  @unique
  email           String?  @unique
  status          String?
  assignedAgentId String?
  assignedAgent   User?    @relation("AgentContacts", fields: [assignedAgentId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  leadId      String?
  ownerId     String
  title       String
  description String?
  type        String
  status      String    @default("TODO")
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lead        Lead?     @relation(fields: [leadId], references: [id])
  owner       User      @relation("TaskOwner", fields: [ownerId], references: [id])
}

model Visit {
  id          String    @id @default(cuid())
  leadId      String
  agentId     String
  address     String?
  scheduledAt DateTime
  checkInAt   DateTime?
  checkOutAt  DateTime?
  latitude    Float?
  longitude   Float?
  summary     String?
  status      String    @default("PLANNED")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lead        Lead      @relation(fields: [leadId], references: [id])
  agent       User      @relation(fields: [agentId], references: [id])
}

model Activity {
  id          String    @id @default(cuid())
  type        String
  leadId      String?
  agentId     String
  title       String
  description String?
  metadata    String?
  occurredAt  DateTime
  createdAt   DateTime  @default(now())
  lead        Lead?     @relation(fields: [leadId], references: [id])
  agent       User      @relation(fields: [agentId], references: [id])
}

model CallEvent {
  id             String    @id @default(cuid())
  leadId         String?
  agentId        String?
  direction      String
  phoneNumber    String
  campaignId     String?
  provider       String
  providerCallId String?
  status         String
  rawPayload     String?
  happenedAt     DateTime
  createdAt      DateTime  @default(now())
  lead           Lead?     @relation(fields: [leadId], references: [id])
  agent          User?     @relation(fields: [agentId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean   @default(false)
  payload   String?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id])
}
